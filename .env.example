# Copia para .env ou define no Pterodactyl (Environment)

# Obrigatório
DISCORD_TOKEN=MTQ4Njg0OTE3NDMyMTUwMDI5MQ.GVzF4G.EzVpGvPUlKtQB1szXiyULPyDXewxwtDN8FcCg0
DISCORD_CLIENT_ID=1486849174321500291

# Tickets: preferência por config.json na raiz (ticketPanelChannelId, ticketCategoryId, staffRoleId).
# Estas variáveis sobrescrevem o ficheiro se definidas:
# TICKET_PANEL_CHANNEL_ID=
# TICKET_CATEGORY_ID=
# STAFF_ROLE_ID=

# Opcional: regista slash commands só neste servidor (recomendado para testes)
# Deixa vazio para comandos globais (podem demorar até ~1h a aparecer)
GUILD_ID=1486476169770700883

# Minecraft — ping do bot a savagemc.net (SRV/MC_PORT); os comandos mostram só o host, sem porta
MC_HOST=savagemc.net
# Porta usada só na query (cliente Minecraft usa o domínio; omite se SRV apontar bem)
MC_PORT=25580
MC_PRESENCE_INTERVAL_MS=45000
MC_STATUS_TIMEOUT_MS=15000
MC_ENABLE_SRV=1

# Canal de voz onde o bot fica sempre (ID). Deixa vazio para desativar.
VOICE_CHANNEL_ID=1486476177240752349
# Verificação periódica para o bot voltar ao canal se sair (predef.: 15s)
VOICE_RECONNECT_INTERVAL_MS=15000

# Canal de texto para logs de transcrições ao fechar ticket
TICKET_LOG_CHANNEL_ID=1486476179878969471

# Cor dos embeds (decimal), ex.: 15158332 = vermelho
TICKET_EMBED_COLOR=43520

# --- Logs gerais do servidor (canal de texto por ID) ---
# Inclui: auditoria (cargos, canais, bans, convites, permissões…), mensagens editadas/apagadas,
# entradas/saídas, voz, comandos slash. O bot precisa de **Ver registo de auditoria** no servidor.
DISCORD_LOG_CHANNEL_ID=1486476179878969468
# Opcional: cada mensagem nova (pode gerar muito tráfego)
# DISCORD_LOG_MESSAGE_CREATE=0
# Reações adicionadas/removidas
# DISCORD_LOG_REACTIONS=0
# Incluir mensagens de outros bots nos logs acima
# DISCORD_LOG_BOT_MESSAGES=0
