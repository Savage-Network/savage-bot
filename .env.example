# Copie para .env na raiz do projeto.
#
# Quase tudo está em config.json na raiz — o ambiente só SOBRESCREVE o JSON (útil no Pterodactyl).
# O único valor obrigatório aqui é o token (não coloque o token no config.json).

# Obrigatório
DISCORD_TOKEN=MTQ4Njg0OTE3NDMyMTUwMDI5MQ.GVzF4G.EzVpGvPUlKtQB1szXiyULPyDXewxwtDN8FcCg0

# Opcional: só se não quiser usar config.json para estes campos
# DISCORD_CLIENT_ID=
# GUILD_ID=
# MC_HOST=
# MC_PORT=
# STATS_SITE_URL=
# SAVAGE_API_BASE_URL=
# EMBED_ACCENT_COLOR=
# VOICE_CHANNEL_ID=
# VOICE_ENABLED=true
# DEV_VOICE_CHANNEL_ID=
# DEV_COMMIT_CHANNEL_ID=
# REPOSITORY_URL=https://github.com/org/repo
# Pterodactyl (opcional — também em ptero.json)
# PTERODACTYL_PANEL_URL=https://panel.exemplo.com
# PTERODACTYL_API_KEY=ptlc_xxxxxxxx
# PTERODACTYL_ALLOW_HTTP=1
# Timeouts (ms) — ConnectTimeoutError: aumenta connect ou verifica rede até ao painel
# PTERO_CONNECT_TIMEOUT_MS=30000
# PTERO_BODY_TIMEOUT_MS=60000
# PTERO_FETCH_TIMEOUT_MS=90000
# Consulta ao painel para registar início/fim/reinício reais (0 = desativar)
# PTERO_STATE_POLL_MS=45000
# PTERO_LOG_CHANNEL_ID=
# PTERO_ROLE_ID=
# AUTOROLE_ROLE_ID=
# AUTO_RESPONSES_JSON=[{"trigger":"palavra","response":"Texto de resposta","wholeWord":false}]
# DISCORD_LOG_CHANNEL_ID=
# etc.
